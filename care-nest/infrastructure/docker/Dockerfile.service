# Multi-stage Dockerfile for NestJS / Node services
# Used by every backend service — keep small and cache-friendly.

ARG NODE_VERSION=22-alpine

FROM node:${NODE_VERSION} AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate

# ---- deps: install all workspace deps (cached) ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY packages ./packages
COPY backend ./backend
COPY frontend ./frontend
RUN pnpm install --frozen-lockfile

# ---- build: compile TS for the target service ----
FROM base AS build
ARG SERVICE
ENV SERVICE=${SERVICE}
COPY --from=deps /app /app
RUN pnpm --filter @carenest/${SERVICE}... build

# ---- prod-deps: install only prod deps for the runtime ----
FROM base AS prod-deps
ARG SERVICE
ENV SERVICE=${SERVICE}
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY packages ./packages
COPY backend ./backend
COPY frontend ./frontend
RUN pnpm install --prod --frozen-lockfile

# ---- runtime ----
FROM node:${NODE_VERSION} AS runtime
ARG SERVICE
ENV SERVICE=${SERVICE}
ENV NODE_ENV=production
WORKDIR /app
RUN apk add --no-cache libc6-compat dumb-init && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001
COPY --from=prod-deps --chown=nodejs:nodejs /app /app
COPY --from=build --chown=nodejs:nodejs /app/backend/${SERVICE}/dist /app/backend/${SERVICE}/dist
USER nodejs
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "node backend/${SERVICE}/dist/main.js"]
