aws_region   = "ap-southeast-1"
admin_cidr   = "203.0.113.10/32"
delete_after = "2026-12-01"
key_name     = null

# Public IPs are deliberate for this no-NAT learning lab. Security groups,
# not public addressing, determine which inbound traffic is permitted.
instances = {
  edge = {
    private_ip = "10.42.0.10", instance_type = "t3.micro",
    security_groups = ["edge", "ops"], root_gb = 20, public_ip = true
  }
  web_buyer = {
    private_ip = "10.42.0.11", instance_type = "t3.micro",
    security_groups = ["web", "ops"], root_gb = 20, public_ip = true
  }
