{
  "name": "@carenest/load-test",
  "version": "1.0.0",
  "description": "CareNest k6 Performance & Load Testing Suite (Phase 3)",
  "private": true,
  "type": "module",
  "scripts": {
    "test:baseline": "k6 run scripts/api-baseline.js",
    "test:stress": "k6 run scripts/api-stress.js",
    "test:spike": "k6 run scripts/spike-test.js",
    "test:soak": "k6 run scripts/soak-test.js",
    "test:payment": "k6 run scripts/payment-load.js",
    "test:ws": "k6 run scripts/websocket-load.js",
    "test:iot": "k6 run scripts/iot-telemetry-load.js",
    "docker:baseline": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/api-baseline.js",
    "docker:stress": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/api-stress.js",
    "docker:spike": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/spike-test.js",
    "docker:soak": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/soak-test.js",
    "docker:payment": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/payment-load.js",
    "docker:ws": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/websocket-load.js",
    "docker:iot": "docker run --rm -i -v \"%cd%:/load-test\" -w /load-test grafana/k6 run scripts/iot-telemetry-load.js"
  },
  "keywords": [
    "k6",
    "load-test",
    "stress-test",
    "carenest",
    "performance"
  ],
  "author": "CareNest Team"
}
