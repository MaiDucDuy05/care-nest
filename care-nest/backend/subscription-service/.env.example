# subscription-service — local dev env
NODE_ENV=development
PORT=3008

# Postgres
DATABASE_URL=postgresql://carenest:carenest_dev@localhost:5432/carenest?schema=public

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=subscription-service

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=care-nest-jwt-secret-dev-2026

# Device activation bridge
ACTIVATION_SECRET=replace-me-with-a-32-byte-random-string
ACTIVATION_TOKEN_TTL_DAYS=30
DEVICE_SERVICE_URL=http://device-service:3004

# Cron toggles
CRON_ENABLED=true
CRON_RENEWAL_HOUR=2
CRON_REMINDER_HOUR=9
CRON_DUNNING_HOUR=14
