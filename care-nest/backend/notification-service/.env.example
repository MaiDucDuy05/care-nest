# notification-service — local dev env
NODE_ENV=development
PORT=3006

# Postgres
DATABASE_URL=postgresql://carenest:carenest_dev@localhost:5432/carenest?schema=public

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service

# Redis (optional — used for rate limiting)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=care-nest-jwt-secret-dev-2026

# VAPID Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@carenest.vn

# ESMS.vn SMS
ESMS_API_KEY=
ESMS_API_SECRET=
ESMS_BRANDNAME=CareNest
ESMS_BASE_URL=https://rest.esms.vn/MainService.svc/json

# AWS SES email
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=no-reply@carenest.vn

# Zalo ZNS
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
ZALO_API_BASE_URL=https://openapi.zalo.me/v2.0
