{
  "name": "@carenest/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-channel notification service (email, SMS, push, Zalo ZNS) for CareNest",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@carenest/database": "workspace:*",
    "@carenest/nestjs-common": "workspace:*",
    "@carenest/shared-config": "workspace:*",
    "@carenest/shared-kafka": "workspace:*",
    "@carenest/shared-types": "workspace:*",
    "@carenest/shared-utils": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "handlebars": "^4.7.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
