# shipping-service — local dev env
NODE_ENV=development
PORT=3009

# Postgres
DATABASE_URL=postgresql://carenest:carenest_dev@localhost:5432/carenest?schema=public

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=shipping-service

# Redis (rate-limit / dedup webhook)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=care-nest-jwt-secret-dev-2026

# Provider credentials (use sandbox keys locally)
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn

GHTK_TOKEN=
GHTK_BASE_URL=https://services.giaohangtietkiem.vn

# Default provider when client doesn't specify
DEFAULT_PROVIDER=GHN
