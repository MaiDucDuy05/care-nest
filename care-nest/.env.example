# CareNest — Environment variables template
# Copy to `.env` for local development. NEVER commit `.env`.
# Use `direnv` / `dotenv` / your shell to load it before running services.

# ----- General -----
NODE_ENV=development
LOG_LEVEL=debug
API_PREFIX=api/v1

# ----- Postgres (TimescaleDB) -----
DATABASE_URL=postgres://carenest:carenest_dev@localhost:5432/carenest
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ----- Kafka -----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=carenest-dev
KAFKA_SSL=false

# ----- Redis -----
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ----- MeiliSearch -----
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=carenest_dev_master_key

# ----- IoT Gateway -----
IOT_GATEWAY_HOST=0.0.0.0
IOT_GATEWAY_PORT=18800
IOT_MAX_BUFFER_SIZE=4096

# ----- JWT / Auth -----
JWT_SECRET=replace-me-with-a-32-byte-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ----- Payment gateways (use sandbox keys locally) -----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/checkout/return

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:3000/checkout/return

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_RETURN_URL=http://localhost:3000/checkout/return

# ----- Logistics -----
GHN_TOKEN=
GHN_SHOP_ID=
GHTK_TOKEN=

# ----- PDPA / privacy -----
PDPA_DATA_RETENTION_DAYS=2555
PDPA_ENCRYPTION_KEY=replace-me-with-a-32-byte-aes-key

# ----- Observability (optional) -----
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
