{
  "name": "@carenest/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema + client for the CareNest platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "prisma generate && tsup",
    "dev": "tsup --watch",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "db:seed": "node --env-file=../../.env dist/seed.js",
    "seed:10k": "tsx --env-file=../../.env scripts/seed-10k-products.ts",
    "seed:10k:clean": "tsx --env-file=../../.env scripts/seed-10k-products.ts --clean",
    "clean": "rm -rf dist .turbo coverage"
  },
  "prisma": {
    "seed": "node --env-file=../../.env dist/seed.js"
  },
  "dependencies": {
    "@carenest/shared-config": "workspace:*",
    "@carenest/shared-types": "workspace:*",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prisma": "^5.20.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
