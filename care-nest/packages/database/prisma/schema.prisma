// Prisma schema for CareNest — 19 entities spanning e-commerce, IoT, and health
// Datasource: PostgreSQL 16 with TimescaleDB extension for time-series
// (vitals, location, alerts)
//
// ID strategy: UUID v7 (time-ordered, sort-friendly) generated by Postgres
// via the `pg_uuidv7` extension. Enable the extension in the initial
// migration with `CREATE EXTENSION IF NOT EXISTS pg_uuidv7;` before any
// table is created.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // TimescaleDB + pg_uuidv7 extensions are enabled in the initial migration
  // via raw SQL (Prisma 5 doesn't have a stable API for PG extensions yet).
}

// -------------------------------------------------------------------------
// Enums
// -------------------------------------------------------------------------

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPPORT
  CAREGIVER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum SellerStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum KycStatus {
  NOT_STARTED
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  VNPAY
  MOMO
  ZALOPAY
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum ShipmentStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum DeviceStatus {
  INACTIVE
  ACTIVE
  MAINTENANCE
  LOST
  DECOMMISSIONED
}

enum AlertType {
  SOS
  FALL
  VITALS_BP_HIGH
  VITALS_BP_LOW
  VITALS_HR_HIGH
  VITALS_HR_LOW
  VITALS_OXYGEN_LOW
  VITALS_TEMP_HIGH
  VITALS_TEMP_LOW
  GEOFENCE_EXIT
  LOW_BATTERY
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED_FALSE
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  OTHER
}

enum AuditActorType {
  USER
  SELLER
  ADMIN
  SUPPORT
  SYSTEM
  ANONYMOUS
}

// -------------------------------------------------------------------------
// 1. User — every account on the platform (also includes caregivers)
// -------------------------------------------------------------------------

model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  fullName        String
  role            UserRole   @default(BUYER)
  status          UserStatus @default(PENDING_VERIFICATION)
  pdpaConsent     Boolean    @default(false)
  pdpaConsentedAt DateTime?
  lastLoginAt     DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecret       String?    // TOTP secret (encrypted at rest in real deploys)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  seller             Seller?
  orders             Order[]
  deviceAssignments  DeviceAssignment[]
  healthRecords      HealthRecord[]
  alertsRaised       Alert[]            @relation("AlertSubject")
  alertsAssigned     Alert[]            @relation("AlertAssignee")
  subscriptions      Subscription[]
  notifications      Notification[]
  careLinksAsUser    Caregiver[]        @relation("CareLinkUser")
  careLinksAsCaretaker Caregiver[]      @relation("CareLinkCaretaker")
  payments           Payment[]
  auditLogs          AuditLog[]
  geofences          Geofence[]

  @@index([role, status])
  @@index([email])
  @@index([phone])
  @@map("users")
}

// -------------------------------------------------------------------------
// 2. Seller — multi-vendor seller profile
// -------------------------------------------------------------------------

model Seller {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String       @unique @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName      String
  storeSlug      String       @unique
  taxId          String?      @unique
  status         SellerStatus @default(DRAFT)
  kycStatus      KycStatus    @default(NOT_STARTED)
  ratingAvg      Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount    Int          @default(0)
  commissionRate Decimal      @default(0.10) @db.Decimal(4, 3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  products   Product[]
  orders     Order[]
  inventory  Inventory[]
  kycDocs    SellerKycDocument[]
  shipments  Shipment[]
  subscriptions Subscription[]

  @@index([status])
  @@index([storeSlug])
  @@map("sellers")
}

// -------------------------------------------------------------------------
// 3. SellerKycDocument — KYC documents for a seller (tax, business license, …)
// -------------------------------------------------------------------------

model SellerKycDocument {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId   String   @db.Uuid
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type       String   // e.g. 'TAX_ID', 'BUSINESS_LICENSE', 'BANK_ACCOUNT', 'ID_CARD'
  fileUrl    String
  status     KycStatus @default(IN_REVIEW)
  reviewedBy String?  @db.Uuid
  reviewedAt DateTime?
  rejectionReason String? @db.Text
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sellerId, type])
  @@map("seller_kyc_documents")
}

// -------------------------------------------------------------------------
// 4. Category — product taxonomy
// -------------------------------------------------------------------------

model Category {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String     @unique
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products  Product[]

  @@index([parentId])
  @@map("categories")
}

// -------------------------------------------------------------------------
// 5. Product — catalog item owned by a seller
// -------------------------------------------------------------------------

model Product {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId    String   @db.Uuid
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String?  @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  slug        String
  description String   @db.Text
  brand       String?
  sku         String?  @unique
  basePrice   Decimal  @db.Decimal(12, 0) // VND, no fractions
  status      String   @default("DRAFT")
  isMedical   Boolean  @default(false)
  requiresRx  Boolean  @default(false)
  isIotDevice Boolean  @default(false)
  iotDeviceModel String?
  compareAtPrice Decimal? @db.Decimal(12, 0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  inventory   Inventory[]
  orderItems  OrderItem[]
  images      ProductImage[]

  @@unique([sellerId, slug])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// -------------------------------------------------------------------------
// 6. ProductImage — product gallery
// -------------------------------------------------------------------------

model ProductImage {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

// -------------------------------------------------------------------------
// 7. Inventory — stock per seller per product per warehouse
// -------------------------------------------------------------------------

model Inventory {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId       String   @db.Uuid
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId        String   @db.Uuid
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  warehouseCode   String   @default("HCM-01")
  quantity        Int      @default(0)
  reserved        Int      @default(0)
  reorderThreshold Int     @default(10)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([productId, warehouseCode])
  @@index([sellerId])
  @@map("inventory")
}

// -------------------------------------------------------------------------
// 8. Order — order header
// -------------------------------------------------------------------------

model Order {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderNumber     String      @unique
  buyerId         String      @db.Uuid
  buyer           User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId        String      @db.Uuid
  seller          Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(CREATED)
  subtotal        Decimal     @db.Decimal(14, 0)
  shippingFee     Decimal     @default(0) @db.Decimal(12, 0)
  discount        Decimal     @default(0) @db.Decimal(12, 0)
  total           Decimal     @db.Decimal(14, 0)
  shippingAddress Json        // { name, phone, line1, ward, district, province, country }
  note            String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([createdAt])
  @@map("orders")
}

// -------------------------------------------------------------------------
// 9. OrderItem — order line item
// -------------------------------------------------------------------------

model OrderItem {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String   // snapshot
  unitPrice   Decimal  @db.Decimal(12, 0)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(14, 0)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// -------------------------------------------------------------------------
// 10. Payment — payment record
// -------------------------------------------------------------------------

model Payment {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String        @unique @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 0)
  transactionRef String?       @unique // gateway-side transaction id
  gatewayResponse Json?        // last full response from gateway
  paidAt         DateTime?
  expiredAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, expiredAt])
  @@map("payments")
}

// -------------------------------------------------------------------------
// 11. Shipment — fulfillment / logistics
// -------------------------------------------------------------------------

model Shipment {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String         @unique @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId      String         @db.Uuid
  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  carrier       String         // 'GHN' | 'GHTK' | 'JT' | 'VTP' | …
  trackingCode  String?        @unique
  status        ShipmentStatus @default(PENDING_PICKUP)
  shippingFee   Decimal        @default(0) @db.Decimal(12, 0)
  weight        Int?           // grams
  estimatedAt   DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failedReason  String?        @db.Text
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sellerId, status])
  @@index([status, estimatedAt])
  @@map("shipments")
}

// -------------------------------------------------------------------------
// 12. Subscription — recurring plan (e.g. monitoring plan, medical kit)
// -------------------------------------------------------------------------

model Subscription {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String?            @db.Uuid
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sellerId          String?            @db.Uuid
  seller            Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  plan              SubscriptionPlan
  status            SubscriptionStatus @default(ACTIVE)
  startedAt         DateTime           @default(now())
  currentPeriodEnd  DateTime
  cancelledAt       DateTime?
  externalId        String?            @unique // gateway-side subscription id
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, status])
  @@index([sellerId, status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// -------------------------------------------------------------------------
// 13. Caregiver — links a caretaker (family member / nurse) to a user
// -------------------------------------------------------------------------

model Caregiver {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation("CareLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  caretakerId  String   @db.Uuid
  caretaker    User     @relation("CareLinkCaretaker", fields: [caretakerId], references: [id], onDelete: Cascade)
  relationship String   // 'FAMILY' | 'NURSE' | 'DOCTOR' | 'OTHER'
  permissions  Json     // { viewHealth: bool, receiveAlerts: bool, manageDevices: bool }
  invitedAt    DateTime @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, caretakerId])
  @@index([caretakerId, acceptedAt])
  @@map("caregivers")
}

// -------------------------------------------------------------------------
// 14. Notification — multi-channel outbound notification
// -------------------------------------------------------------------------

model Notification {
  id          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  templateKey String              // e.g. 'order.confirmed', 'alert.sos'
  payload     Json                // template variables
  subject     String?
  body        String              @db.Text
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failureCode String?
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, attempts])
  @@map("notifications")
}

// -------------------------------------------------------------------------
// 15. Device — IoT GPS watch (Wonlex V3.2 compatible)
// -------------------------------------------------------------------------

model Device {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId         String       @unique // 10-15 digit IMEI
  model            String       @default("care-nest-V3.2")
  firmware         String?
  status           DeviceStatus @default(INACTIVE)
  lastSeenAt       DateTime?
  lastBattery      Int?
  registeredAt     DateTime     @default(now())
  decommissionedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignments    DeviceAssignment[]
  healthRecords  HealthRecord[]
  alerts         Alert[]

  @@index([status])
  @@map("devices")
}

// -------------------------------------------------------------------------
// 16. DeviceAssignment — links a User to a Device
// -------------------------------------------------------------------------

model DeviceAssignment {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId     String    @db.Uuid
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  notes        String?   @db.Text

  @@unique([deviceId, userId, assignedAt])
  @@index([userId])
  @@index([deviceId, unassignedAt])
  @@map("device_assignments")
}

// -------------------------------------------------------------------------
// 17. HealthRecord — vitals / location / heartbeat data points
//     Used as a TimescaleDB hypertable in migration.
// -------------------------------------------------------------------------

model HealthRecord {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId   String   @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordType String   // 'LOCATION' | 'HEARTBEAT' | 'VITALS_BP_HR' | 'VITALS_OXYGEN' | 'VITALS_TEMP'
  measuredAt DateTime // device-reported timestamp
  receivedAt DateTime @default(now()) // server ingest time
  data       Json     // record-specific payload (lat/lon, bphrt, oxygen, temp, etc.)
  battery    Int?
  gsmSignal  Int?

  @@index([deviceId, measuredAt(sort: Desc)])
  @@index([userId, recordType, measuredAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
  @@map("health_records")
}

// -------------------------------------------------------------------------
// 18. Alert — SOS / fall / vitals alerts
// -------------------------------------------------------------------------

model Alert {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId       String        @db.Uuid
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  subjectId      String        @db.Uuid // user the alert is about
  subject        User          @relation("AlertSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  assigneeId     String?       @db.Uuid // operator / caregiver
  assignee       User?         @relation("AlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  type           AlertType
  severity       AlertSeverity
  status         AlertStatus   @default(OPEN)
  occurredAt     DateTime      // device-reported
  receivedAt     DateTime      @default(now()) // server ingest time
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  payload        Json          // raw alert payload (lat/lon at alert time, vitals, etc.)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, severity, receivedAt(sort: Desc)])
  @@index([subjectId, occurredAt(sort: Desc)])
  @@index([deviceId, occurredAt(sort: Desc)])
  @@map("alerts")
}

// -------------------------------------------------------------------------
// 19. AuditLog — immutable audit trail
// NFR-0.3: 7 fields (actorId, actorType, action, entityType, entityId,
// before, after) + occurredAt + ip + userAgent. Retained 7 years per
// Vietnamese accounting + PDPA requirements.
// -------------------------------------------------------------------------

model AuditLog {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Actor
  actorId     String?        @db.Uuid  // null for SYSTEM / ANONYMOUS
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType   AuditActorType
  // Action
  action      AuditAction
  entityType  String         // e.g. 'User', 'Order', 'Payment', 'Device'
  entityId    String?        @db.Uuid
  // Before/after snapshots (JSON)
  before      Json?
  after       Json?
  // Request context
  ip          String?
  userAgent   String?        @db.Text
  requestId   String?        @db.Uuid // for distributed tracing
  occurredAt  DateTime       @default(now())

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

// -------------------------------------------------------------------------
// 20. Geofence — circular safe zone for a user's IoT device
// -------------------------------------------------------------------------

model Geofence {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String   // e.g. "Nhà riêng", "Trường mẫu giáo"
  centerLat    Decimal  @db.Decimal(10, 7)
  centerLon    Decimal  @db.Decimal(10, 7)
  radiusMeters Int      @default(150)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([userId, active])
  @@map("geofences")
}
